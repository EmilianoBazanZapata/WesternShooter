# Burst / IL2CPP / Bee
# =========================================================

/[Bb]ee/
/[Bb]urst[Dd]ebug[Ii]nformation/
/[Ii]l2cpp[Bb]uild[Cc]ache/
/[Aa]rtifacts/

# =========================================================
# Unity Package Manager
# =========================================================

# Keep Packages/manifest.json and packages-lock.json committed.
# Ignore package caches if generated locally.
/[Pp]ackages/packages-lock.json.tmp
/[Pp]ackages/.cache/

