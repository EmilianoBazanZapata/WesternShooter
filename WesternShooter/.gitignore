# =========================================================
# Unity generated folders
# =========================================================

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Local build outputs
/[Bb]uild/
/[Bb]uilds/
/[Bb]uildOutput/
/[Dd]ist/

# Unity cache server
/[Cc]acheServer/

# =========================================================
# Unity generated files
# =========================================================

sysinfo.txt
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash files
crashlytics-build.properties
*.stacktrace

# Unity lock files
UnityLockfile

# =========================================================
# Keep valid Unity meta files
# =========================================================

# Meta files must generally be committed with their assets.
!/[Aa]ssets/**/*.meta
!/[Pp]ackages/**/*.meta

