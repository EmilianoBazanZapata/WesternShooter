*.log
*.bak
*.backup
*.old
*.orig
*.rej
*.swp
*.swo
*.tmp
*.temp
*.cache

# =========================================================
# Compression and local archives
# =========================================================

*.zip
*.rar
*.7z
*.tar
*.tar.gz

# Uncomment these if you intentionally keep archives in the repo.
# !/Docs/**/*.zip

# =========================================================
# Local environment and secrets
# =========================================================

.env
.env.*
!.env.example

*.keystore
*.jks
*.p12
*.pfx
*.cer
*.key
*.pem

# Android signing
keystore.properties

# Firebase / service credentials
google-services.json
GoogleService-Info.plist
serviceAccountKey.json
firebase-adminsdk*.json

# Uncomment these exceptions if the app intentionally requires
# Firebase config files to be versioned.
# !/[Aa]ssets/Plugins/Android/google-services.json
# !/[Aa]ssets/GoogleService-Info.plist

